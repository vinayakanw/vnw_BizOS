DATABASE_URL=postgresql+psycopg://bizos:bizos@localhost:5432/bizos
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Sales Agent LLM. Get a free key at aistudio.google.com
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Phase 13-14
# SECRETS_KEY=            # encrypts stored SMTP/Slack credentials. Defaults to a key derived from JWT_SECRET.
# ENVIRONMENT=production  # turns on startup safety checks (strong JWT_SECRET, secure cookies, real CORS origins)
# COOKIE_SECURE=true      # required in production (HTTPS only)
# COOKIE_SAMESITE=lax     # use "none" (with COOKIE_SECURE=true) if frontend and API are on different sites
# TRUST_FORWARDED_FOR=false  # true only behind a proxy that sets X-Forwarded-For (needed for correct rate limits)
# RUN_SCHEDULER_IN_API=true  # false when running `python -m app.worker` as a separate process
